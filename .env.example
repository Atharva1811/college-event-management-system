# Frontend Environment Configuration
# API Base URL (Used when VITE_USE_MOCK_DATA is set to false)
VITE_API_URL=http://localhost:5000/api

# Service Abstraction Mode
# Set to 'true' for realistic in-memory demo mode (No MongoDB Atlas needed)
# Set to 'false' to route all frontend services directly to Node.js backend & MongoDB Atlas
VITE_USE_MOCK_DATA=true
