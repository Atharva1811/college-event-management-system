# API Base URL (Configured with production Render Web Service)
VITE_API_URL=https://college-event-management-system-1qmx.onrender.com/api

# Service Mode
# Set to 'false' (default) to route all frontend services directly to Node.js backend & MongoDB Atlas
# Set to 'true' only if running offline without a database
VITE_USE_MOCK_DATA=false
